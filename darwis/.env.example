# Session secret for session management (change in production)
SESSION_SECRET=dev_secret_change_in_production

# Database connection URL (SQLite for development)
DATABASE_URL=sqlite:///db/development.sqlite3

# Z.ai API key for AI chat functionality (required)
# Get your API key from https://z.ai
ZAI_API_KEY=your_zai_api_key_here

# Z.ai API base URL (optional, default: https://api.z.ai/api/paas/v4/)
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# API timeout in seconds (optional, default: 30)
# ZAI_TIMEOUT=30
